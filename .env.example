# Copy this file to .env and fill in your own keys. Never commit .env.

# Required: free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Required: free key from https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional: shows what's trending on YouTube for a topic.
# Google Cloud console → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=

# Optional limits for a public deployment
MAX_VIDEOS_PER_HOUR=4
MAX_QUEUE=6
WORKERS=1
KEEP_MINUTES=120
